<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core.Server\Core.Server.csproj" />
    <ProjectReference Include="..\Char.Server\Char.Server.csproj" />
    <ProjectReference Include="..\Login.Server\Login.Server.csproj" />
  </ItemGroup>

  <!--
    Integration tests reference types (DeferredLoginServerRuntime,
    LoginSessionPacketUseCase, ILoginSessionPacketUseCase) that no longer
    exist in Login.Server. Tests have been stale since the use-case layer
    was refactored. Excluded from build until rewritten or removed.
  -->
  <ItemGroup>
    <Compile Remove="Integration\LoginServerSocketIntegrationTests.cs" />
    <Compile Remove="Integration\CharServerSocketIntegrationTests.cs" />
  </ItemGroup>

</Project>
